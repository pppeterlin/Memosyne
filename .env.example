# ── Memosyne Environment Variables ──

# Ollama host (local LLM backend)
# Default: http://127.0.0.1:11434
# When using Docker Compose with the local-llm profile, set to: http://ollama:11434
OLLAMA_HOST=http://127.0.0.1:11434

# ── Where things live (all optional; see docs/configuration.md) ──
# MEMOSYNE_HOME=/path/to/project            # holds .env, spring/ and the default vault
# MEMOSYNE_VAULT_DIR=/path/to/your/vault    # your Markdown memories (keep it out of this repo)
# MEMOSYNE_ARTIFACT_DIR=/path/to/your/vault/_artifacts   # indexes, caches, logs
# MEMOSYNE_SPRING_DIR=/path/to/spring       # drop zone

# ── Search ──
# core = dense (if installed) + BM25 fusion. full = also graph, PPR, backlink
# boost and ACT-R reranking from memosyne.labs (needs the labs extra).
# MEMOSYNE_SEARCH_PROFILE=core
# AI chat transcripts are searched only on request unless this is 1.
# MEMOSYNE_SEARCH_CHATS=0
# Set to 0 to leave AI chats out of the index entirely (then: memosyne rebuild --full).
# MEMOSYNE_INDEX_CHATS=1

# ── MCP ──
# all = also expose the memosyne.labs tools (consolidation, corrections, …).
# MEMOSYNE_MCP_TOOLS=core

# Embedding model runtime.
# Default is local-first/offline: use cached Hugging Face models and skip network checks.
# Set to 0 only when bootstrapping a fresh machine that needs to download the model.
MEMOSYNE_HF_OFFLINE=1

# Local embedding device: auto | cpu | mps | cuda（預設 auto）
# auto 會挑當下最快的裝置；Apple Silicon 上是 mps（約 2x CPU）。
# 只影響 MEMOSYNE_EMBED_PROVIDER=local。
# MEMOSYNE_EMBED_DEVICE=auto

# ── Embedding backend (v0.8: pluggable) ──
# Where the heavy batch embedding work runs. Default = local CPU (same as v0.7).
#   local        : local sentence-transformers (no setup, backward compatible)
#   ollama       : self-hosted GPU server running Ollama  (POST /api/embed)
#   openai-compat: public/self-hosted OpenAI-style endpoint (POST /v1/embeddings)
# MEMOSYNE_EMBED_PROVIDER=ollama
# MEMOSYNE_EMBED_URL=http://gpu-host:11434      # remote endpoint (no trailing path)
# MEMOSYNE_EMBED_MODEL=nomic-embed-text         # ollama: model name / openai: model id
# MEMOSYNE_EMBED_DIM=768                         # declare dim to catch silent mismatch
# MEMOSYNE_EMBED_API_KEY=sk-...                 # only for public cloud openai-compat
# MEMOSYNE_EMBED_TIMEOUT=30                      # seconds per request (optional)
# MEMOSYNE_EMBED_RETRIES=3                       # retries w/ exponential backoff (optional)
# MEMOSYNE_EMBED_BATCH=64                        # docs per HTTP request (optional)

# LLM provider selection.
# Default provider resolution is model-name based; set this only when forcing a backend.
# LLM_PROVIDER=ollama

# DeepSeek API — the default enrichment model is deepseek:deepseek-flash.
# DEEPSEEK_API_KEY=your_deepseek_key_here

# OpenRouter backend (optional).
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI-compatible proxy backend (optional).
# PROXY_API_KEY=your_proxy_key_here
# PROXY_BASE_URL=http://localhost:3000/claude-kiro-oauth/v1

# Experimental retrieval tuning. Leave at 1.0 unless evaluating.
# CHAT_CATEGORY_KNOWLEDGE_PENALTY=1.0
